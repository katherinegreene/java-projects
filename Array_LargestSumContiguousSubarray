/* 
Largest Sum Contiguous Subarray
This program finds the maximum sum of a contiguous subarray
within a given one-dimensional array using a variation of
Kadane's Algorithm.

Input example: nums = [-2,1,-3,4,-1,2,1,-5,4]
Output: 6
Explanation: The subarray [4,-1,2,1] has the largest sum = 6.
*/

public class Array_LargestSumContiguousSubarray {

    // Method to find the largest sum contiguous subarray
    public static int maxSum(int[] arr) {
        int max = 0;   // stores the maximum sum found so far
        int temp = 0;  // stores the current subarray sum

        // Loop over the array
        for (int i = 0; i < arr.length; i++) {  // <-- Fixed: need to initialize i=0
            int each = arr[i];                  // <-- Fixed: 'each' was undefined, assign arr[i] to it
            temp = temp + each;                 // Add current element to current sum

            // If current sum is negative, reset it to 0
            temp = Integer.max(temp, 0);

            // Update max if current sum is greater than max
            max = Integer.max(max, temp);
        }

        return max;  // return the maximum sum found
    }

    // Optional main to test the method
    public static void main(String[] args) {
        int[] nums = {-2, 1, -3, 4, -1, 2, 1, -5, 4};
        int result = maxSum(nums);
        System.out.println("Largest Sum Contiguous Subarray: " + result);  // Should print 6
    }
}
